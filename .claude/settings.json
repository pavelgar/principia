{
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(scripts/setup.sh)",
      "Bash(scripts/setup.sh *)",
      "Bash(scripts/client-gametest.sh)",
      "Bash(scripts/client-gametest.sh *)",
      "Bash(scripts/test-agent-guard.sh)",
      "Bash(scripts/check-skills.sh)",
      "Bash(scripts/stop-check.sh)",
      "Bash(scripts/verify.sh)",
      "Bash(scripts/verify.sh *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run download *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "deny": [
      "Bash(./gradlew *publish_live*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/agent-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/stop-check.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
