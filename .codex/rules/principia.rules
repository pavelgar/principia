# Codex command rules for Principia (the equivalent of the permissions in .claude/settings.json).
# Syntax: https://learn.chatgpt.com/docs/agent-configuration/rules. The strictest matching rule wins.
# Note: "allow" runs the command outside Codex's sandbox (Gradle needs network access and ~/.gradle).
# Rules can't match flags in the middle of a command or tell reads from writes; scripts/agent-guard.sh
# (PreToolUse hook) covers those cases.

prefix_rule(
    pattern = ["./gradlew"],
    decision = "allow",
    justification = "Gradle builds and game tests need network access and ~/.gradle.",
    match = [["./gradlew", "build"], ["./gradlew", "runGameTest"]],
)

prefix_rule(
    pattern = [["scripts/setup.sh", "scripts/client-gametest.sh"]],
    decision = "allow",
    justification = "Project setup and headless client game tests.",
)

prefix_rule(
    pattern = [["scripts/test-agent-guard.sh", "scripts/check-skills.sh", "scripts/stop-check.sh"]],
    decision = "allow",
    justification = "The repo's self-checks: the guard's tests, the skill symlinks, and the Stop hook's quickCheck.",
)

prefix_rule(
    pattern = ["git", ["status", "diff", "log", "show"]],
    decision = "allow",
    justification = "Read-only git commands.",
)

prefix_rule(
    pattern = ["gh", "pr", "checks"],
    decision = "allow",
    justification = "Reads a PR's CI checks, to wait for them before calling the work done.",
)

prefix_rule(
    pattern = ["gh", "run", ["view", "download"]],
    decision = "allow",
    justification = "Reads CI logs and downloads CI's evidence (screenshots, game-test logs, crash reports).",
    match = [["gh", "run", "view", "123", "--log-failed"], ["gh", "run", "download", "123", "-n", "client-game-test-output"]],
)

# Defence in depth for scripts/agent-guard.sh, in case the hook isn't active.
prefix_rule(
    pattern = [["scripts/play.sh", "xvfb-run"]],
    decision = "forbidden",
    justification = "play.sh never exits; xvfb-run's default display breaks OpenGL. Use scripts/client-gametest.sh.",
)

prefix_rule(
    pattern = ["./gradlew", ["--stop", "runClient", "runServer"]],
    decision = "forbidden",
    justification = "--stop kills other worktrees' builds; runClient/runServer never exit. Use runGameTest or scripts/client-gametest.sh.",
)

prefix_rule(
    pattern = [["git", "gh"], ["push", "release"]],
    decision = "prompt",
    justification = "A pushed v* tag publishes a release; the human approves pushes.",
)
