# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Byte for byte, whatever core.autocrlf says: textures and saved fuzz inputs.
*.png           binary
**/*FuzzTestInputs/** binary
