#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Shell scripts use lf, whatever core.autocrlf says: bash fails on a \r at the end of a line.
/gradlew        text eol=lf
*.sh            text eol=lf
scripts/lib/*   text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Byte for byte, whatever core.autocrlf says: textures and saved fuzz inputs.
*.png           binary
**/*FuzzTestInputs/** binary
