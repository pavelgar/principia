# kotlin
.kotlin/

# personal agent settings/instructions (shared ones are committed). Note: a CLAUDE.local.md stops Claude Code
# from reading AGENTS.md, so prefer .claude/settings.local.json / AGENTS.override.md for personal tweaks.
.claude/settings.local.json
CLAUDE.local.md
AGENTS.override.md

# local reference tree for coding agents (scripts/setup.sh); no trailing slash so a symlink is ignored too
/.references

# Claude Code worktrees (claude --worktree, subagent isolation, background sessions)
/.claude/worktrees/

# jazzer

.cifuzz-corpus/
